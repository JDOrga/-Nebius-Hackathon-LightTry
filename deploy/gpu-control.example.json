{
  "schemaVersion": 1,
  "enabled": false,
  "factory": "cpu_supervisor:build_sessions",
  "guardRoot": "/var/lib/lighttry/guard",
  "scopeFile": "/etc/lighttry/gpu-scope.json",
  "protection": {
    "mode": "cpu-only",
    "cpuHostRiskAccepted": true
  },
  "binding": {
    "providerFactory": "nebius_provider:build",
    "providerBinding": {
      "cliPath": "/opt/nebius/bin/nebius",
      "configFile": "/run/secrets/nebius-config.yaml",
      "profile": "SERVICE_PROFILE",
      "tenantId": "TENANT_ID",
      "projectId": "PROJECT_ID",
      "resourceId": "RESOURCE_ID",
      "publicKeyFile": "/etc/lighttry/gpu-authorized-key.pub",
      "guardRoot": "/var/lib/lighttry/guard"
    },
    "workerOrigin": "https://GPU_WORKER_HOST",
    "workerTokenFile": "/run/secrets/lighttry-worker-token",
    "workerCaFile": "/etc/lighttry/gpu-worker-ca.pem",
    "workerCertificateSha256": "CURRENT_GPU_CERTIFICATE_SHA256_64_HEX"
  }
}
