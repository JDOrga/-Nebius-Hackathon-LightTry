# Install only on the GPU host AFTER verifying its current identity.
# Replace GPU_WORKER_HOST and CPU_HOST_CIDR. No redirect or public 9080 listener.
server {
    listen 443 ssl;
    server_name GPU_WORKER_HOST;
    ssl_certificate /etc/lighttry/tls/worker-fullchain.pem;
    ssl_certificate_key /etc/lighttry/tls/worker-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    allow CPU_HOST_CIDR;
    deny all;
    client_max_body_size 32m;
    access_log off;
    error_log /var/log/nginx/lighttry-worker-error.log warn;
    location ~ "^/v1/(health|jobs|jobs/[0-9a-f]{32}|blobs/[0-9a-f]{64})$" {
        limit_except GET POST PUT { deny all; }
        proxy_pass http://127.0.0.1:9080;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Connection "";
        proxy_redirect off;
        proxy_request_buffering on;
        proxy_buffering off;
        proxy_connect_timeout 3s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;
    }
    location / { return 404; }
}
