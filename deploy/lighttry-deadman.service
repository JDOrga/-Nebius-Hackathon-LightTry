[Unit]
Description=LightTry OFF-HOST stop-only lease fallback
After=network.target
# Install on a management host outside the CPU and GPU fault domains.

[Service]
Type=simple
User=lighttry
Group=lighttry
WorkingDirectory=/opt/lighttry
EnvironmentFile=/etc/lighttry/deadman.env
ExecStart=/opt/lighttry/.venv/bin/python -X utf8 -B /opt/lighttry/start.py --deadman --data-root /var/lib/lighttry-deadman --guard-config /etc/lighttry/deadman.json
Restart=on-failure
RestartSec=3
StateDirectory=lighttry-deadman
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lighttry-deadman
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
