# Runtime bindings only. Actual files stay outside code/image, owned by service UID, mode 0600.
LIGHTTRY_DATA_ROOT=/var/lib/lighttry
LIGHTTRY_PUBLIC_ORIGIN=http://localhost:8080
LIGHTTRY_ACCOUNTS_FILE=/var/lib/lighttry/auth/accounts.json
LIGHTTRY_LEGACY_OWNER=lighttry
# Optional credentials do NOT enable paid services or supply authorization/budget.
# LIGHTTRY_NEMOTRON_KEY_FILE=/run/secrets/nemotron
# LIGHTTRY_NEBIUS_CREDENTIAL_FILE=/run/secrets/nebius
# Optional audited factory + separate new scope. Absent means GPU control OFF.
# Same private file is also used by lighttry-guard.service.
# LIGHTTRY_GPU_CONTROL_CONFIG=/etc/lighttry/gpu-control.json
# Optional exact per-owner/input/recipe grant; absent means model dispatch OFF.
# LIGHTTRY_MODEL_GRANT_FILE=/etc/lighttry/model-grant.json
