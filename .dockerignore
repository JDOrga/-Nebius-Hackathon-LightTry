# Allow-list the CPU service source. Never include photos, tasks, personal config,
# venvs, accepted results, cloud evidence or arbitrary static/media directories.
**
!start.py
!requirements-cpu.txt
!scripts/
scripts/**
!scripts/weights.py
!cloud/
cloud/**
!cloud/cli_bridge.py
!cloud/remote_probe.py
!manifests/
manifests/**
!manifests/patch_manifest.json
!manifests/weights_manifest.json
!manifests/upstream.json
!project/
project/**
!project/*.py
!project/web/
project/web/**
!project/web/*.html
!project/web/*.css
!project/web/*.js
!project/data/
project/data/**
!project/data/catalog.json
!project/data/demo-package.json
!project/inference/
project/inference/**
!project/inference/*.py
!project/runtime/
project/runtime/**
!project/runtime/*.py
!project/runtime/*.json
!project/experiments/
project/experiments/**
!project/experiments/*.py
!deploy/
deploy/**
!deploy/Dockerfile
# Deny sensitive names even within allow-listed runtime directories.
**/.local/**
**/__pycache__/**
**/accounts.json
**/*credentials*
**/*.pem
**/*.key
**/tasks/**
**/photos/**
