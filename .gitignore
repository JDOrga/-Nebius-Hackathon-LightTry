# Defense in depth. Git admission uses manifests/git-allowlist.txt too.
*
!*/
!.gitignore
!.gitattributes
!README.md
!docs/*.md
!config/local.example.json
!cloud/*.ps1
!cloud/*.py
!cloud/*.cs
!scripts/*.py
!tests/*.py
!prototype/*.py
!requirements/*.txt
!third_party/Cosmos-LICENSE
!patches/*.patch
!manifests/*.json
!manifests/git-allowlist.txt
.git/
config/local.json
.local/
cloud-runs/
results/
artifacts/
evidence/
upstream/
__pycache__/
*.pyc
*.log
*.zip
*.tar
*.gz
*.npy
*.pt
*.safetensors
*.env
.env*
known_hosts*
*.pem
*.key
id_rsa*
id_ed25519*
